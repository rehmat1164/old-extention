{
  "action": {
    "default_title": "Open Mete Run",
    "default_icon": "images/logo.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "host_permissions": [
    "https://www.meta.ai/*",
    "https://*.fbcdn.net/*",
    "https://gist.githubusercontent.com/*",
    "https://integrate.api.nvidia.com/*"
  ],
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/logo.png"
  },
  "manifest_version": 3,
  "name": "Mete Run",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "downloads",
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.meta.ai/*"
      ],
      "js": [
        "content-auto-open.js"
      ],
      "run_at": "document_start"
    }
  ],
  "version": "1.0.1",
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "images/logo.png",
        "sidepanel.html",
        "folder-picker.html",
        "floating-manager.html",
        "download-manager.html",
        "js/folder-picker.js",
        "js/floating-manager-init.js",
        "js/download-manager.js",
        "js/download-overlay.js",
        "js/download-overlay.css",
        "js/download-state.js",
        "js/download-detector.js",
        "js/download-actions.js",
        "js/prompt-gate.js",
        "js/ai-retry-status-panel.js",
        "js/gemini-client.js",
        "auto Meta new logo animation.gif",
        "generating animation.gif"
      ]
    }
  ]
}
