{
  "manifest_version": 3,
  "name": "Mete Run",
  "version": "2.0.0",
  "version_name": "2.0.0 local test",
  "minimum_chrome_version": "120",
  "description": "Three local workflows: Meta AI images, Vibes image-to-video, and prompt-to-image-to-video. No remote configuration or updater.",
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/logo.png"
  },
  "action": {
    "default_title": "Open Mete Run",
    "default_icon": "images/logo.png"
  },
  "background": {"service_worker": "background.js", "type": "module"},
  "side_panel": {"default_path": "sidepanel.html"},
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "tabs", "offscreen"],
  "host_permissions": [
    "https://meta.ai/*",
    "https://www.meta.ai/*",
    "https://vibes.ai/*",
    "https://www.vibes.ai/*",
    "https://*.fbcdn.net/*",
    "https://*.fbsbx.com/*"
  ],
  "content_scripts": [{
    "matches": ["https://meta.ai/*", "https://www.meta.ai/*", "https://vibes.ai/*", "https://www.vibes.ai/*"],
    "js": ["js/automation/dom.js", "js/automation/meta.js", "js/automation/vibes.js", "js/content.js"],
    "run_at": "document_idle"
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
